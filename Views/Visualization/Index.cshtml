@model PCBuilder.Models.Build

@{
    ViewData["Title"] = $"Visualizing {Model.BuildName}";
}

<div class="visualization-container" style="width: 100%; max-width: 100%; padding: 0 15px;">
    <div class="d-flex gap-3" style="align-items: flex-start; flex-wrap: nowrap;">
        <!-- Visualization -->
        <div style="flex: 1; min-width: 0;">
            <div id="pc-viewer" style="width: 100%; height: 800px; background: #111122; border-radius: 20px; border: 2px solid #00f0ff;"></div>
        </div>
    
        <!-- Info panel -->
        <div style="width: 280px; min-width: 280px; flex-shrink: 0;">
            <div class="card" style="background: rgba(18, 18, 18, 0.9);">
                <div class="card-body">
                    <h5 class="card-title" style="color: #00f0ff;">@Model.BuildName</h5>
                    <p class="text-muted">Created: @Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                    
                    <h6 class="mt-3" style="color: #00ff88;">Parts in this build:</h6>
                    <ul class="list-unstyled">
                        @foreach (var item in Model.BuildItems)
                        {
                            <li class="mb-2" style="border-left: 3px solid #00f0ff; padding-left: 10px;">
                                <strong style="color: white;">@item.Product.Brand @item.Product.ModelName</strong><br />
                                <small style="color: #a0a0a0;">@item.Product.Category?.CategoryName</small>
                            </li>
                        }
                    </ul>
                    
                    <div class="mt-3" style="border-top: 1px solid #333; padding-top: 10px;">
                        <strong style="color: #00ff88;">Total:</strong>
                        <span style="color: white; font-size: 1.2rem;">$@Model.BuildItems.Sum(i => i.Quantity * i.Product.Price).ToString("0.00")</span>
                    </div>
                    
                    <div class="mt-3 text-center">
                        <button id="resetViewBtn" class="btn btn-sm btn-outline-primary">Reset View</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="~/js/pc-visualizer-simple.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
        requestAnimationFrame(() => {
        const visualizer = new SimplePCVisualizer('pc-viewer');
        visualizer.loadBuild(@Model.Id);
                
        setTimeout(() => visualizer.resize(), 200);
                
        window.addEventListener('resize', () => visualizer.resize());
        document.getElementById('resetViewBtn').addEventListener('click', () => {
        visualizer.camera.position.set(5, 3, 10);
        visualizer.camera.lookAt(0, 0, 0);
        });
        });
        });
    </script>
}